---
/**
 * Standalone FAQ page (/faq/)
 * Reuses FaqAccordion (items: { q, a }[]) + its auto FAQPage JSON-LD,
 * plus explicit FAQPage block for standalone indexing.
 */
import Base from "../../layouts/Base.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";

const SITE = "https://thesmarter.github.io";

const items = [
  {
    q: "What is Smart Team?",
    a: "Smart Team is an open-source collective operating across three GitHub organizations — thesmarter (core platform), AdaaSystem (ERP and business systems), and DetaElectPro (medical and electrophysiology). We build practical, production-grade software and publish it openly so anyone can inspect, reuse, and improve it.",
  },
  {
    q: "Where is the team based?",
    a: "We are a distributed, remote-first collective with roots in Sudan and collaborators across multiple time zones. All coordination happens in the open on GitHub — issues, discussions, and pull requests are our headquarters.",
  },
  {
    q: "What kinds of projects do you maintain?",
    a: "Forty public repositories spanning developer tooling, Astro/Tailwind starters, ERP modules (HR, inventory, accounting), medical signal tooling, mobile apps, and automation scripts. Each repository page lists its language, topics, stars, and live links so you can judge fit in seconds.",
  },
  {
    q: "How can I contribute?",
    a: "Pick an issue labelled good-first-issue, fork the repo, create a focused branch, and open a pull request. Clone with git clone, push your branch, then run gh pr create. Maintainers review every PR — small, well-tested changes merge fastest.",
  },
  {
    q: "What licenses do you use?",
    a: "Most projects use permissive licenses (MIT or Apache-2.0) so you can use them commercially with attribution. A few ERP and medical packages use copyleft or custom terms where data-safety demands it. Every repository declares its license in its root LICENSE file and on its repo page.",
  },
  {
    q: "Do you offer commercial support?",
    a: "Yes. For deployment, customization, training, and SLAs — especially around AdaaSystem ERP and DetaElectPro clinical tooling — open an issue or discussion on the relevant repository with the tag commercial-support. We scope fixed-price and retainer engagements in the open wherever possible.",
  },
  {
    q: "How do I report a security issue?",
    a: "Do not open a public issue for vulnerabilities. Email the maintainers via the address listed in the repository SECURITY.md, or use GitHub private vulnerability reporting. Include reproduction steps, affected versions, and impact. We acknowledge reports within 72 hours and publish fixes with credit.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.a },
  })),
};
---

<Base
  title="FAQ — Smart Team Open Source Hub"
  description="Frequently asked questions about Smart Team: what we build, where we work, how to contribute, licenses, commercial support, and security reporting."
  canonical={SITE + "/faq/"}
  ogImage={SITE + "/og/cover.png"}
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-4xl px-5 py-16 lg:px-8">
    <nav aria-label="Breadcrumb" class="font-accent text-xs uppercase tracking-[0.2em] text-muted-fg">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-neon">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-neon">FAQ</li>
      </ol>
    </nav>
    <p class="section-label terminal-prefix mt-8">FAQ // FREQUENT_QUERIES</p>
    <h1 class="mt-4 font-display text-4xl font-black uppercase tracking-wide md:text-6xl">
      <span class="cyber-glitch" data-text="QUESTIONS">QUESTIONS</span>
      <span class="block text-xl text-neon glow md:text-2xl">answered plainly_</span>
    </h1>
    <p class="mt-6 leading-relaxed text-fg/85">
      Everything newcomers ask before their first clone — who we are, what we maintain,
      how to contribute, and how to reach us for support or security reports.
    </p>
    <div class="mt-10">
      <FaqAccordion items={items} idPrefix="faq-page" />
    </div>
    <div class="cyber-chamfer mt-10 border border-border bg-card p-6">
      <h2 class="font-display text-lg font-bold uppercase">Still stuck?</h2>
      <p class="mt-2 text-sm text-fg/80">
        Open a discussion on any repository, or browse the full catalog to find the right codebase.
      </p>
      <div class="mt-4 flex flex-wrap gap-4">
        <a href="/#catalog" class="cyber-chamfer-sm inline-flex min-h-[44px] items-center border-2 border-neon bg-neon px-6 py-3 font-accent text-sm font-bold uppercase tracking-[0.2em] text-bg hover:brightness-110">Browse catalog</a>
        <a href="/" class="inline-flex min-h-[44px] items-center font-accent text-sm uppercase tracking-[0.2em] text-muted-fg hover:text-neon">← Back home</a>
      </div>
    </div>
  </div>
</Base>
