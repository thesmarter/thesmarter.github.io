---
/**
 * OrgCard.astro — organisation profile card.
 * props: { login, name?, avatarUrl?, bio?, repoCount?, stars?, followers?, url?, accent?: 'green'|'cyan'|'magenta' }
 */
interface Props {
  login: string;
  name?: string;
  avatarUrl?: string;
  bio?: string;
  repoCount?: number;
  stars?: number;
  followers?: number;
  url?: string;
  accent?: 'green' | 'cyan' | 'magenta';
}
const {
  login,
  name,
  avatarUrl,
  bio,
  repoCount,
  stars,
  followers,
  url,
  accent = 'green',
} = Astro.props as Props;

const accentColor = accent === 'cyan' ? '#00d4ff' : accent === 'magenta' ? '#ff00ff' : '#00ff88';
const href = url ?? `https://github.com/${login}`;
const label = `VIEW_GITHUB_ORG_${login.toUpperCase()}`;
const initials = (name ?? login).slice(0, 2).toUpperCase();
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="group relative flex min-h-[44px] items-center gap-4 border border-[#2a2a3a] bg-[#12121a] p-4 font-mono transition-all duration-300 hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00ff88] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0f] hover:shadow-[0_0_5px_#00ff88,0_0_10px_#00ff8840]"
  style="clip-path: polygon(0 10px, 10px 0, calc(100% - 10px) 0, 100% 10px, 100% calc(100% - 10px), calc(100% - 10px) 100%, 10px 100%, 0 calc(100% - 10px));"
>
  <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1" style={`background: ${accentColor}; box-shadow: 0 0 8px ${accentColor};`}></span>

  {avatarUrl ? (
    <img
      src={avatarUrl}
      alt={`${login} avatar`}
      width="56"
      height="56"
      loading="lazy"
      class="h-14 w-14 shrink-0 border border-[#2a2a3a] object-cover"
    />
  ) : (
    <span
      aria-hidden="true"
      class="flex h-14 w-14 shrink-0 items-center justify-center border border-[#2a2a3a] bg-[#0a0a0f] text-lg font-black tracking-widest"
      style={`color: ${accentColor};`}
    >
      {initials}
    </span>
  )}

  <span class="min-w-0 flex-1">
    <span class="block truncate text-sm font-bold uppercase tracking-[0.2em] text-[#e0e0e0] group-hover:text-[#00ff88]">
      @{login}
    </span>
    {name && <span class="block truncate text-[12px] uppercase tracking-[0.2em] text-[#6b7280]">{name}</span>}
    {bio && <span class="mt-1 line-clamp-1 block text-[12px] normal-case tracking-wide text-[#6b7280]">{bio}</span>}
    <span class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] uppercase tracking-[0.2em] text-[#e0e0e0]">
      {repoCount !== undefined && <span>REPOS:{repoCount}</span>}
      {stars !== undefined && <span>★:{stars}</span>}
      {followers !== undefined && <span>FOLLOW:{followers}</span>}
    </span>
  </span>

  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-[#6b7280] group-hover:text-[#00ff88]"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
</a>
