---
/**
 * IconBox.astro — lucide inline SVG (stroke 1.5), no extra package.
 * props: { icon: 'github'|'star'|'fork'|'external'|'search'|'mail'|'globe'|'x', label?: string, size?: number, box?: boolean, class?: string }
 */
interface Props {
  icon: 'github' | 'star' | 'fork' | 'external' | 'search' | 'mail' | 'globe' | 'x';
  label?: string;
  size?: number;
  box?: boolean;
  class?: string;
}
const { icon, label, size = 20, box = true, class: klass = '' } = Astro.props as Props;

const PATHS: Record<string, string> = {
  // lucide github
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  // lucide star
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  // lucide git-fork
  fork: '<circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/>',
  // lucide arrow-up-right
  external: '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  // lucide search
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  // lucide mail
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  // lucide globe
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  // lucide x
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
};
const inner = PATHS[icon] ?? PATHS.x;
const boxClass = box
  ? 'inline-flex min-h-[44px] min-w-[44px] items-center justify-center border border-[#2a2a3a] bg-[#12121a] p-2.5 text-[#00ff88] transition-all hover:border-[#00ff88] hover:shadow-[0_0_5px_#00ff88,0_0_10px_#00ff8840] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00ff88]'
  : 'inline-flex min-h-[44px] min-w-[44px] items-center justify-center text-current';
---

<span
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  title={label}
  class={`font-mono ${boxClass} ${klass}`}
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="transition-[filter] hover:[filter:drop-shadow(0_0_4px_currentColor)]"
    set:html={inner}
  />
</span>
