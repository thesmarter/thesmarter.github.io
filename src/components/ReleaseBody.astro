---
/**
 * ReleaseBody.astro -- minimal dependency-free markdown renderer for
 * GitHub release notes.
 *
 * props: { body?: string | null }
 * Supports: headings ##/###, tables (|...|), fenced code blocks ``` +
 * inline `code`, bold **, lists -/1., links [t](u), horizontal ---,
 * paragraphs. XSS-safe: escapes HTML first, then applies transforms.
 * Each block gets dir=auto (Arabic U+0600-U+06FF detected via a literal
 * range test below renders dir="rtl" + text-right).
 */
interface Props {
  body?: string | null;
}

const { body } = Astro.props as Props;
const raw: string = typeof body === "string" ? body : "";

function escapeHtml(s: string): string {
  return String(s ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

const ARABIC_RE = /[؀-ۿ]/;

function hasArabic(s: string): boolean {
  return ARABIC_RE.test(s);
}

function blockDir(rawText: string): string {
  return hasArabic(rawText) ? 'dir="rtl"' : 'dir="auto"';
}

function rtlClass(rawText: string): string {
  return hasArabic(rawText) ? " text-right" : "";
}

function safeHref(u: string): string | null {
  const t = String(u ?? "").trim();
  if (!t) return null;
  if (/^\s*(javascript|data|vbscript|file|blob):/i.test(t)) return null;
  if (/^(https?:\/\/|mailto:|tel:|\/|#|\.\/|\.\.\/)/i.test(t)) return t.replace(/"/g, "%22");
  if (/^[\w~.-][\w~.\-/#?=&%+:@;(),]*$/i.test(t) && !/\s/.test(t)) return t.replace(/"/g, "%22");
  return null;
}

function renderInline(escapedSrc: string): string {
  const codes: string[] = [];
  // Extract inline code first so ** and links inside code stay literal.
  // Placeholder uses "@@RBCODE<n>@@", which cannot collide with escaped text
  // (@ is never produced by escapeHtml and the pattern is distinctive).
  let out = String(escapedSrc).replace(/`([^`\n]+?)`/g, (_m, c: string) => {
    codes.push(
      `<code class="border border-[#2a2a3a] bg-[#0a0a0f] px-1.5 py-0.5 text-[0.85em] text-[#00d4ff]">${c}</code>`,
    );
    return `@@RBCODE${codes.length - 1}@@`;
  });
  // bold **
  out = out.replace(/\*\*([^*]+?)\*\*/g, '<strong class="font-bold text-[#e0e0e0]">$1</strong>');
  // links [t](u)
  out = out.replace(/\[([^\]]+?)\]\(([^)\s]+?)\)/g, (_m, t: string, u: string) => {
    const href = safeHref(u);
    if (!href) return t;
    const ext = /^https?:\/\//i.test(href);
    return `<a href="${href}"${ext ? ' target="_blank" rel="noopener noreferrer"' : ""} class="text-[#00d4ff] underline decoration-[#00d4ff]/40 underline-offset-[3px] hover:text-[#00ff88] hover:decoration-[#00ff88]">${t}</a>`;
  });
  out = out.replace(/@@RBCODE(\d+)@@/g, (_m, i: string) => codes[Number(i)] ?? "");
  return out;
}

function splitTableRow(line: string): string[] {
  let t = line.trim();
  if (t.startsWith("|")) t = t.slice(1);
  if (t.endsWith("|")) t = t.slice(0, -1);
  return t.split("|");
}

function isSeparator(line: string): boolean {
  const t = line.trim();
  if (!/-/.test(t)) return false;
  return /^\|?[\s:|\-]+?\|?[\s:|\-]*$/.test(t);
}

function renderTable(headerCells: string[], rows: string[][]): string {
  const th = headerCells
    .map(
      (c) =>
        `<th ${blockDir(c)} class="border border-[#2a2a3a] bg-[#1c1c2e] px-3 py-2 text-left text-[12px] font-bold uppercase tracking-[0.2em] text-[#00ff88]">${renderInline(escapeHtml(c.trim()))}</th>`,
    )
    .join("");
  const trs = rows
    .map((r) => {
      const tds = r
        .map(
          (c) =>
            `<td ${blockDir(c)} class="border border-[#2a2a3a] px-3 py-2 text-sm${rtlClass(c)}">${renderInline(escapeHtml(c.trim())) || "<span aria-hidden='true'>--</span>"}</td>`,
        )
        .join("");
      return `<tr class="odd:bg-[#12121a] even:bg-[#0a0a0f] hover:bg-[#1c1c2e]">${tds}</tr>`;
    })
    .join("");
  return `<div class="cyber-chamfer-sm overflow-x-auto border border-[#2a2a3a]" dir="ltr"><table class="w-full border-collapse font-mono"><thead><tr>${th}</tr></thead><tbody>${trs}</tbody></table></div>`;
}

function renderMarkdown(src: string): string {
  const text = String(src ?? "").replace(/\r\n?/g, "\n");
  if (!text.trim()) return "";
  const lines = text.split("\n");
  let html = "";
  let i = 0;

  while (i < lines.length) {
    const line = lines[i];

    // fenced code block
    if (/^\s*```/.test(line)) {
      const lang = line.replace(/^\s*```/, "").trim().slice(0, 24);
      const buf: string[] = [];
      i++;
      while (i < lines.length && !/^\s*```/.test(lines[i])) {
        buf.push(lines[i]);
        i++;
      }
      if (i < lines.length) i++; // skip closing fence
      const codeEsc = escapeHtml(buf.join("\n"));
      const langLabel = lang ? escapeHtml(lang.toUpperCase()) : "TERMINAL";
      html += `<div class="cyber-chamfer-sm border border-[#2a2a3a] bg-[#0a0a0f]" dir="ltr"><div class="flex min-h-[44px] items-center justify-between gap-2 border-b border-[#2a2a3a] bg-[#12121a] px-3"><p class="flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-[#6b7280]"><span class="inline-block h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="inline-block h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="inline-block h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span><span class="ml-1 text-[#00ff88]">${langLabel}</span></p><button type="button" data-copy-code aria-label="Copy code block" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-2 text-[11px] uppercase tracking-[0.2em] text-[#6b7280] hover:text-[#00ff88] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00ff88]">COPY</button></div><pre class="overflow-x-auto p-4 text-[13px] leading-relaxed text-[#e0e0e0]"><code>${codeEsc || "<span class='text-[#6b7280]'>// EMPTY</span>"}</code></pre></div>`;
      continue;
    }

    // horizontal rule
    if (/^\s*---+\s*$/.test(line)) {
      html += `<hr class="border-0 border-t border-[#2a2a3a]" aria-hidden="true" />`;
      i++;
      continue;
    }

    // headings ## / ### (# also tolerated)
    const hm = line.match(/^\s*(#{1,3})\s+(.*)$/);
    if (hm) {
      const level = hm[1].length;
      const rawText = hm[2].trim();
      const inner = renderInline(escapeHtml(rawText));
      const cls =
        level <= 1
          ? "font-display text-xl font-bold uppercase tracking-wide text-[#e0e0e0]"
          : level === 2
            ? "font-display text-lg font-bold uppercase tracking-wide text-[#00ff88]"
            : "font-display text-base font-semibold uppercase tracking-wide text-[#00d4ff]";
      const prefix = level <= 1 ? "# " : level === 2 ? "## " : "### ";
      html += `<h${level} ${blockDir(rawText)} class="${cls}${rtlClass(rawText)}"><span aria-hidden="true" class="text-[#00ff88]">${prefix}</span>${inner}</h${level}>`;
      i++;
      continue;
    }

    // tables: header row + separator row + body rows
    if (line.includes("|") && i + 1 < lines.length && isSeparator(lines[i + 1])) {
      const header = splitTableRow(line);
      i += 2; // skip header + separator
      const rows: string[][] = [];
      while (i < lines.length && lines[i].includes("|") && lines[i].trim() !== "") {
        rows.push(splitTableRow(lines[i]));
        i++;
      }
      const n = header.length;
      const normRows = rows.map((r) => {
        const c = r.slice(0, n);
        while (c.length < n) c.push("");
        return c;
      });
      html += renderTable(header, normRows);
      continue;
    }

    // lists (- / * / + / 1. / 1) )
    if (/^\s*([-*+]\s+|\d+[.)]\s+)/.test(line)) {
      const items: { ordered: boolean; text: string }[] = [];
      while (i < lines.length && /^\s*([-*+]\s+|\d+[.)]\s+)/.test(lines[i])) {
        const m = lines[i].match(/^\s*(?:[-*+]\s+|\d+[.)]\s+)(.*)$/);
        const ordered = /^\s*\d+[.)]\s+/.test(lines[i]);
        items.push({ ordered, text: (m?.[1] ?? "").trim() });
        i++;
      }
      const ordered = items.length > 0 && items[0].ordered;
      const tag = ordered ? "ol" : "ul";
      const listCls = ordered
        ? "list-decimal space-y-2 pl-6 font-mono text-sm leading-relaxed text-[#e0e0e0]"
        : "space-y-2 font-mono text-sm leading-relaxed text-[#e0e0e0]";
      const lis = items
        .map(({ text: t }) => {
          const inner = renderInline(escapeHtml(t));
          const marker = ordered
            ? ""
            : `<span aria-hidden="true" class="mr-2 text-[#00ff88]">&gt;</span>`;
          return `<li ${blockDir(t)} class="${ordered ? "" : "flex items-start"}${rtlClass(t)}">${marker}<span>${inner}</span></li>`;
        })
        .join("");
      html += `<${tag} class="${listCls}">${lis}</${tag}>`;
      continue;
    }

    // blank -> skip
    if (/^\s*$/.test(line)) {
      i++;
      continue;
    }

    // paragraph: gather consecutive plain lines
    const buf: string[] = [line];
    i++;
    while (
      i < lines.length &&
      !/^\s*$/.test(lines[i]) &&
      !/^\s*```/.test(lines[i]) &&
      !/^\s*(#{1,3})\s+/.test(lines[i]) &&
      !/^\s*---+\s*$/.test(lines[i]) &&
      !/^\s*([-*+]\s+|\d+[.)]\s+)/.test(lines[i]) &&
      !(lines[i].includes("|") && i + 1 < lines.length && isSeparator(lines[i + 1]))
    ) {
      buf.push(lines[i]);
      i++;
    }
    const rawPara = buf.join(" ").trim();
    html += `<p ${blockDir(rawPara)} class="font-mono text-sm leading-relaxed tracking-wide text-[#6b7280]${rtlClass(rawPara)}">${renderInline(escapeHtml(rawPara))}</p>`;
  }

  return html;
}

const html = renderMarkdown(raw);
---

<div class="release-body flex flex-col gap-4 font-mono" dir="auto">
  {html ? (
    <Fragment set:html={html} />
  ) : (
    <div class="cyber-chamfer-sm border border-[#2a2a3a] bg-[#0a0a0f] p-4 text-sm" dir="auto">
      <p class="uppercase tracking-[0.2em] text-[#00ff88]">&gt; NO_BODY <span aria-hidden="true" class="animate-pulse">▊</span></p>
      <p class="mt-1 text-[12px] uppercase tracking-[0.2em] text-[#6b7280]">// EMPTY_TRANSMISSION</p>
    </div>
  )}
</div>

<script>
  (() => {
    if (typeof window === "undefined") return;
    if (window["__releaseBodyCopyInit"]) return;
    window["__releaseBodyCopyInit"] = true;
    async function copyText(t) {
      try {
        await navigator.clipboard.writeText(t);
        return true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = t;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
          return true;
        } catch {
          return false;
        }
      }
    }
    document.addEventListener("click", async (e) => {
      const btn = e.target && e.target.closest ? e.target.closest("[data-copy-code]") : null;
      if (!btn) return;
      const wrap = btn.closest("div.cyber-chamfer-sm");
      const code = wrap ? wrap.querySelector("pre code") : null;
      const text = code ? code.innerText : "";
      if (!text) return;
      const ok = await copyText(text);
      const orig = btn.textContent;
      btn.textContent = ok ? "COPIED OK" : "FAIL X";
      setTimeout(() => { btn.textContent = orig; }, 1400);
    });
  })();
</script>

<style>
  .release-body :is(h1, h2, h3) { overflow-wrap: anywhere; }
  .release-body p { overflow-wrap: anywhere; }
  .release-body pre { scrollbar-width: thin; }
</style>
